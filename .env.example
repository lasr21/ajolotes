# Copia este archivo para desarrollo local:
#   cp .env.example .env.local
# En Vercel: Project Settings → Environment Variables (Production y Preview).
# O, después de `npx vercel link`, bájalas con: npx vercel env pull .env.local

# Clave de la API de Anthropic (créditos del evento). Solo servidor.
ANTHROPIC_API_KEY=

# Modelo para el code review. Haiku es el más rápido; se cambia sin tocar código.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Tiempo máximo del review antes de usar una reseña de respaldo, en milisegundos.
REVIEW_TIMEOUT_MS=4000

# Secreto para firmar las ligas de las tarjetas (P1). Genera uno con:
#   openssl rand -hex 32
SHARE_SECRET=

# URL pública del sitio, sin "/" al final. En Vercel, tu dominio o el *.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Liga oficial de boletos de JSConf MX. El juego le agrega ?ref=ajolotes.
NEXT_PUBLIC_TICKETS_URL=
